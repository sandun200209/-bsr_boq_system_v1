# ==============================================================================
# BSR Rate Hub – Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# For Local Docker:
DATABASE_URL=postgresql+psycopg://bsr_user:bsr_password@postgres:5432/bsr_boq
POSTGRES_DB=bsr_boq
POSTGRES_USER=bsr_user
POSTGRES_PASSWORD=bsr_password

# For Centralized Supabase Cloud PostgreSQL (Uncomment and fill in):
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 2. Centralized Cloud Document Storage (Supabase Storage)
# ------------------------------------------------------------------------------
# If omitted or set to 'local', documents are stored in UPLOAD_DIR on local disk.
# If 'supabase', documents are uploaded to your Supabase Storage bucket.
STORAGE_BACKEND=auto
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=bsr-documents

# Local upload directory fallback
UPLOAD_DIR=/data/uploads

# ------------------------------------------------------------------------------
# 3. Authentication & Security Secrets
# ------------------------------------------------------------------------------
# Secret key for signing JWT tokens (Change this to a long random secret in production)
JWT_SECRET=bsr-rate-hub-secure-jwt-secret-key-2026-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 4. Networking & Hosting
# ------------------------------------------------------------------------------
PORT=8080
APP_URL=http://localhost:8080
